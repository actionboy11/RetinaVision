# Copy this file to docker/.env and replace every placeholder locally.
# Never commit docker/.env or reuse these example values outside local development.
MYSQL_ROOT_PASSWORD=replace_with_a_random_local_root_password
MYSQL_USER=retina
MYSQL_PASSWORD=replace_with_a_random_local_app_password
RABBITMQ_USER=retina
RABBITMQ_PASSWORD=replace_with_a_random_local_rabbitmq_password
